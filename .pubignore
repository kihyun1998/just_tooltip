# Internal engineering artifacts — kept in the git repo, not shipped to pub.dev.
.github/
CLAUDE.md
CONTEXT.md
docs/
project_kr.md
project_kr_meta.md
blogman-draft.md

# Build output (anywhere) — the example's .gitignore misses this, so it would
# otherwise leak hundreds of MB of compiled artifacts into the package.
build/

# A .pubignore makes pub disregard .gitignore entirely, so anything git ignores
# must be repeated here or it ships. These two did.
coverage/
pubspec.lock

# Example platform scaffolding — pub.dev only needs example/lib to show the
# example; the runner dirs are regenerated by `flutter create` on the consumer
# side and only bloat the published archive.
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/
example/.dart_tool/
example/.flutter-plugins-dependencies
